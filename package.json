{
  "name": "create-ahad-backend",
  "version": "0.1.0",
  "description": "Scaffold a Node.js + Express + TypeScript + TypeORM + PostgreSQL + JWT backend with one command.",
  "type": "module",
  "bin": {
    "create-ahad-backend": "dist/bin/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "create-ahad-backend",
    "scaffold",
    "express",
    "typeorm",
    "postgresql",
    "jwt",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^5.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.12.7",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
